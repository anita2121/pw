<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dear Space - Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<style>
html {
    scroll-behavior: smooth;
}

:root {
    --base-font: 16px;
    --ratio: 1.618;

    --font-md: calc(var(--base-font) * var(--ratio));
    --font-lg: calc(var(--font-md) * var(--ratio));

    --space-sm: 16px;
    --space-md: 26px;
    --space-lg: 42px;
    --space-xl: 68px;

    --bg-color: #f5f0eb;
    --secondary-color: #e6c79c;
    --accent-color: #c68b59;
    --text-color: #4a3f35;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg-color);
    color: var(--text-color);
}

/* NAVBAR */
.navbar {
    position: sticky;
    top: 0;
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 8%;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    z-index: 1000;
}

.navbar h1 {
    color: var(--accent-color);
}

.navbar ul {
    display: flex;
    list-style: none;
    gap: 20px;
    margin-left: auto;
}

.navbar a {
    text-decoration: none;
    color: var(--text-color);
    font-weight: 500;
}

.navbar a:hover {
    color: var(--accent-color);
}

/* HERO */
.hero {
    text-align: center;
    margin-top: var(--space-lg);
}

.logo img {
    width: 150px;
}

.header {
    text-align: center;
    font-size: var(--font-lg);
    color: var(--accent-color);
    margin-bottom: var(--space-xl);
}

/* BOX */
.desc-box {
    background: white;
    margin: auto;
    padding: var(--space-lg);
    width: 90%;
    max-width: 750px;
    border-radius: 20px;
    margin-bottom: var(--space-xl);
}

/* VISI MISI */
.visi-misi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
    width: 90%;
    margin: auto;
    margin-bottom: var(--space-xl);
}

.card {
    background: linear-gradient(135deg, var(--secondary-color), #f0d4b2);
    padding: var(--space-md);
    border-radius: 20px;
}

/* SECTION */
.section {
    text-align: center;
    margin-bottom: var(--space-xl);
}

/* VIDEO (SUDAH DIPERKECIL) */
.video-box {
    width: 80%;
    max-width: 500px;
    margin: auto;
}

.video-box video {
    width: 100%;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

/* GALERI */
.gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    width: 90%;
    margin: auto;
}

.gallery img {
    width: 100%;
    border-radius: 15px;
}

/* LAYANAN */
.list-box {
    background: var(--accent-color);
    color: white;
    display: inline-block;
    padding: var(--space-md);
    border-radius: 20px;
}

.list-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
}

/* KONTAK */
.kontak {
    background: var(--secondary-color);
    text-align: center;
    padding: var(--space-xl);
}

/* FOOTER */
.footer {
    text-align: center;
    padding: 20px;
    background: #3e3228;
    color: white;
}

/* RESPONSIVE */
@media(max-width:600px){
    .gallery {
        grid-template-columns: repeat(2, 1fr);
    }
    .list-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">
    <h1>Dear Space</h1>
    <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#tentang">Tentang</a></li>
        <li><a href="#galeri">Contoh Konsep</a></li>
        <li><a href="#layanan">Layanan</a></li>
        <li><a href="#kontak">Kontak</a></li>
    </ul>
</div>

<!-- HOME -->
<div id="home" class="hero">
    <div class="logo">
        <img src="foto1.jpeg">
    </div>
    <div class="header">Dear Space</div>
</div>

<!-- TENTANG -->
<div id="tentang">
    <div class="desc-box">
        <p><b>Dear Space</b> adalah jasa dekorasi ruang yang menciptakan suasana nyaman, estetik, dan penuh makna.</p>
    </div>

    <div class="visi-misi">
        <div class="card">
            <h3>VISI</h3>
            <p>Menjadi jasa dekorasi ruang yang kreatif.</p>
        </div>
        <div class="card">
            <h3>MISI</h3>
            <ul>
                <li>Desain modern</li>
                <li>Nyaman</li>
                <li>Pelayanan terbaik</li>
            </ul>
        </div>
    </div>
</div>

<!-- GALERI -->
<div id="galeri" class="section">
    <h2>Contoh Konsep</h2>

    <div class="video-box">
        <video controls>
            <source src="video1.mp4">
        </video>
    </div>

    <br><br>

    <div class="gallery">
        <img src="foto2.jpg">
        <img src="foto3.jpg">
        <img src="foto4.jpg">
        <img src="foto5.jpg">
    </div>
</div>

<!-- LAYANAN -->
<div id="layanan" class="section">
    <h2>Layanan</h2>

    <div class="list-box">
        <div class="list-grid">
            <div>
                <b>Layanan:</b>
                <ul>
                    <li>Dekorasi Kamar</li>
                    <li>Ruang Kerja</li>
                    <li>Ruang Tamu</li>
                    <li>Dekorasi Acara</li>
                </ul>
            </div>

            <div>
                <b>Konsep:</b>
                <ul>
                    <li>Minimalis</li>
                    <li>Aesthetic</li>
                    <li>Korean Style</li>
                    <li>Earth Tone</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- KONTAK -->
<div id="kontak" class="kontak">
    <h2>Kontak Kami</h2>
    <p>📱 0812-3456-7890</p>
    <p>📷 @dearspace.id</p>
    <p>📍 Tangerang</p>
</div>

<!-- FOOTER -->
<div class="footer">
    © 2026 Dear Space | All Rights Reserved
</div>

</body>
</html>
